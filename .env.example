# 安塘智宣 · 环境变量（复制本文件为 .env 并填入真实值；.env 绝不提交 git！）
# 说明：scripts/ 下的 Python 脚本（test_skill.py、fetch_hotlist.py）读本文件；
#       web/ 网页端读 web/.env，两份需分别配置。

# 火山方舟 API 密钥（必需，test_skill.py 用）
ARK_API_KEY=

# 模型 / 接入点 ID（形如 ep-xxxx 或 doubao-xxx，必需）
ARK_MODEL=

# 图像模型（Seedream，海报背景图用，可选；未配置则跳过生图环节）
ARK_IMAGE_MODEL=

# 热榜 API 地址（可选，fetch_hotlist.py 用）
# Docker 自建 DailyHotApi：http://localhost:6688
# 或公共实例：https://api-hot.imsyy.top （以实际可用为准）
# HOTLIST_API_BASE=

# 海报字体（可选，render_poster.py 用；不设置则自动探测系统中文字体）
# POSTER_FONT=
# POSTER_FONT_BOLD=
